<?xml version="1.0" encoding="utf-8"?>
<!-- the offline player (OfflineScreen): a TextureView, settable only here. PlayerView's default SurfaceView draws behind the
     window through a hole; shrunk into PiP, the hole followed but the video didn't (old size in a corner, the home screen around it) -->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view" />
