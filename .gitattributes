# shell scripts keep LF even in a Windows checkout (autocrlf): with CRLF, WSL/Linux cannot run them (gradlew: ENOENT)
android/gradlew text eol=lf
*.sh text eol=lf
# capacitor writes these with LF on every sync: as CRLF they'd show as changed after each fresh build
android/capacitor.settings.gradle text eol=lf
android/app/capacitor.build.gradle text eol=lf
