{
  "manifest_version": 3,
  "name": "Medflix",
  "version": "1.0",
  "description": "Lets the Medflix website reach its sites from your own browser, where Cloudflare's check can be passed.",
  "permissions": ["declarativeNetRequest"],
  "host_permissions": ["https://*/*"],
  "background": { "service_worker": "background.js", "scripts": ["background.js"] },
  "content_scripts": [{ "matches": ["https://med-flix-ten.vercel.app/*", "http://localhost/*"], "js": ["bridge.js"], "run_at": "document_start" }],
  "browser_specific_settings": { "gecko": { "id": "medflix@medamine", "strict_min_version": "128.0" } }
}
